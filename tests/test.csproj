<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gốc mã nguồn chính -->
  <PropertyGroup>
    <RepoRoot>..\TA-ITS015-WEBAPI-V1.0</RepoRoot>
  </PropertyGroup>

  <!-- Cấu hình TargetFramework: Chỉ bật net10.0-windows khi có project WPF, bình thường chỉ test net10.0 -->
  <PropertyGroup Condition="Exists('$(RepoRoot)\src\Services\VideoWall\ITS.VideoWall.WPF\ITS.VideoWall.WPF.csproj')">
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFrameworks)' == ''">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <!-- Loại trừ runner độc lập VwMockServerRunner khỏi test.csproj -->
    <DefaultItemExcludes>$(DefaultItemExcludes);VwMockServerRunner\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.*" />
  </ItemGroup>

  <!-- Dự án Web API chính -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)\src\TAC_WebAPI\TAC_WebAPI.csproj" />
  </ItemGroup>

  <!-- Thư viện chia sẻ -->
  <ItemGroup>
    <Reference Include="Shared.Infrastructure">
      <HintPath>$(RepoRoot)\src\DLLs\Shared.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="Shared.Core">
      <HintPath>$(RepoRoot)\src\DLLs\Shared.Core.dll</HintPath>
    </Reference>
    <Reference Include="Shared.Core.Security">
      <HintPath>$(RepoRoot)\src\DLLs\Shared.Core.Security.dll</HintPath>
    </Reference>
    <Reference Include="Modules.System">
      <HintPath>$(RepoRoot)\src\DLLs\Modules.System.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- ══════════════════ CẤU HÌNH ĐIỀU KIỆN THEO MODULE ══════════════════ -->

  <!-- Đường dẫn project module kiểm tra tồn tại -->
  <PropertyGroup>
    <ShareDataWorkerProject>$(RepoRoot)\src\Services\ShareData\ShareDataWorker\ShareDataWorker.csproj</ShareDataWorkerProject>
    <ShareDataWorkerCoreProject>$(RepoRoot)\src\Services\ShareData\ShareDataWorker.Core\ShareDataWorker.Core.csproj</ShareDataWorkerCoreProject>
    <ShareDataModuleProject>$(RepoRoot)\src\Modules\ShareData\Module.ShareData\Module.ShareData.csproj</ShareDataModuleProject>
    <VideoWallModuleProject>$(RepoRoot)\src\Modules\VideoWall\Module.VideoWall\Module.VideoWall.csproj</VideoWallModuleProject>
    <VideoWallIsapiSource>$(RepoRoot)\src\Modules\VideoWall\Module.VideoWall.Core\Interfaces\IVwISAPIDeviceClient.cs</VideoWallIsapiSource>
    <VideoWallWorkerProject>$(RepoRoot)\src\Services\VideoWall\ITS.VideoWall\ITS.VideoWall.csproj</VideoWallWorkerProject>
    <VideoWallWpfProject>$(RepoRoot)\src\Services\VideoWall\ITS.VideoWall.WPF\ITS.VideoWall.WPF.csproj</VideoWallWpfProject>
  </PropertyGroup>

  <!-- Cờ kích hoạt biên dịch theo module có sẵn trong nhánh -->
  <PropertyGroup>
    <HasShareDataWorker>false</HasShareDataWorker>
    <HasShareDataWorker Condition="Exists('$(ShareDataWorkerProject)') And Exists('$(ShareDataWorkerCoreProject)')">true</HasShareDataWorker>

    <HasShareDataModule>false</HasShareDataModule>
    <HasShareDataModule Condition="Exists('$(ShareDataModuleProject)')">true</HasShareDataModule>

    <HasVideoWallModule>false</HasVideoWallModule>
    <HasVideoWallModule Condition="Exists('$(VideoWallModuleProject)')">true</HasVideoWallModule>

    <!-- Test ShareData: Yêu cầu cả ShareDataWorker và Module.ShareData -->
    <CanCompileShareDataTests>false</CanCompileShareDataTests>
    <CanCompileShareDataTests Condition="'$(HasShareDataWorker)' == 'true' And '$(HasShareDataModule)' == 'true'">true</CanCompileShareDataTests>

    <!-- Test VideoWall: Yêu cầu Module.VideoWall và interface ISAPI -->
    <CanCompileVideoWallTests>false</CanCompileVideoWallTests>
    <CanCompileVideoWallTests Condition="'$(HasVideoWallModule)' == 'true' And Exists('$(VideoWallIsapiSource)')">true</CanCompileVideoWallTests>

    <HasVideoWallWpf>false</HasVideoWallWpf>
    <HasVideoWallWpf Condition="Exists('$(VideoWallWpfProject)')">true</HasVideoWallWpf>

    <!-- Test WPF: Yêu cầu project client WPF, test VideoWall nền và TFM net10.0-windows -->
    <CanCompileVideoWallWpfTests>false</CanCompileVideoWallWpfTests>
    <CanCompileVideoWallWpfTests Condition="'$(HasVideoWallWpf)' == 'true' And '$(CanCompileVideoWallTests)' == 'true' And '$(TargetFramework)' == 'net10.0-windows'">true</CanCompileVideoWallWpfTests>
  </PropertyGroup>

  <!-- Hằng số biên dịch (#if HAS_*) dùng trong Host.cs -->
  <PropertyGroup Condition="'$(HasVideoWallModule)' == 'true'">
    <DefineConstants>$(DefineConstants);HAS_VIDEOWALL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CanCompileVideoWallWpfTests)' == 'true'">
    <DefineConstants>$(DefineConstants);HAS_VIDEOWALL_WPF</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HasShareDataModule)' == 'true'">
    <DefineConstants>$(DefineConstants);HAS_SHAREDATA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HasShareDataWorker)' == 'true'">
    <DefineConstants>$(DefineConstants);HAS_SHAREDATAWORKER</DefineConstants>
  </PropertyGroup>

  <!-- Tham chiếu ShareDataWorker nếu có (chỉ ở TFM net10.0) -->
  <ItemGroup Condition="'$(HasShareDataWorker)' == 'true' And '$(TargetFramework)' != 'net10.0-windows'">
    <ProjectReference Include="$(ShareDataWorkerProject)" />
    <ProjectReference Include="$(ShareDataWorkerCoreProject)" />
  </ItemGroup>

  <!-- Tham chiếu VideoWall Worker nếu có -->
  <ItemGroup Condition="Exists('$(VideoWallWorkerProject)')">
    <ProjectReference Include="$(VideoWallWorkerProject)" />
  </ItemGroup>

  <!-- Tham chiếu Client WPF (chỉ ở TFM net10.0-windows) -->
  <ItemGroup Condition="'$(CanCompileVideoWallWpfTests)' == 'true'">
    <ProjectReference Include="$(VideoWallWpfProject)" />
  </ItemGroup>

  <!-- Loại bỏ file test của module vắng mặt khỏi biên dịch (ShareData là backend, không test ở net10.0-windows) -->
  <ItemGroup Condition="'$(CanCompileShareDataTests)' != 'true' Or '$(TargetFramework)' == 'net10.0-windows'">
    <Compile Remove="ShareData\**\*.cs" />
    <None Include="ShareData\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CanCompileVideoWallTests)' != 'true'">
    <Compile Remove="VideoWall\**\*.cs" />
    <None Include="VideoWall\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CanCompileVideoWallWpfTests)' != 'true'">
    <Compile Remove="VideoWall\Wpf\**\*.cs" />
    <None Include="VideoWall\Wpf\**\*.cs" />
  </ItemGroup>

  <!-- VwMockServerRunner là console exe độc lập, không tham gia test assembly -->
  <ItemGroup>
    <Compile Remove="VwMockServerRunner\**\*.cs" />
    <None Include="VwMockServerRunner\**" />
  </ItemGroup>

  <!-- Báo cáo trạng thái module trước khi build -->
  <Target Name="ReportOptionalTestModules" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="[TEST MODULES] Module.VideoWall=$(HasVideoWallModule) (ISAPI=$(CanCompileVideoWallTests)) | Module.ShareData=$(HasShareDataModule) | ShareDataWorker=$(HasShareDataWorker)" />
    <Message Importance="high" Condition="'$(HasShareDataWorker)' != 'true'" Text="[TEST MODULES] ShareDataWorker(.Core) không tồn tại -> bỏ ProjectReference." />
    <Message Importance="high" Condition="'$(CanCompileShareDataTests)' != 'true'" Text="[TEST MODULES] Loại khỏi biên dịch: tests/ShareData/**" />
    <Message Importance="high" Condition="'$(HasVideoWallModule)' == 'true' And '$(CanCompileVideoWallTests)' != 'true'" Text="[TEST MODULES] Module.VideoWall có nhưng thiếu feature ISAPI -> loại tests/VideoWall/**" />
    <Message Importance="high" Condition="'$(HasVideoWallModule)' != 'true'" Text="[TEST MODULES] Loại khỏi biên dịch: tests/VideoWall/**" />
    <Message Importance="high" Text="[TEST MODULES] TFM=$(TargetFramework) | Module.VideoWall.WPF=$(HasVideoWallWpf) (test Wpf=$(CanCompileVideoWallWpfTests))" />
    <Message Importance="high" Condition="'$(HasVideoWallWpf)' == 'true' And '$(TargetFramework)' != 'net10.0-windows'" Text="[TEST MODULES] TFM $(TargetFramework) không tham chiếu được net10.0-windows -> loại tests/VideoWall/Wpf/**." />
  </Target>

</Project>
