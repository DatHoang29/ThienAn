  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// ── Digest Auth thủ công cho ISAPI (RFC 7616) ──────────────────────\r",
          "// Postman runtime 2.1.2 lỗi ở đường retry Digest, nên tự làm.\r",
          "// Đặt Auth type = No Auth ở cấp collection.\r",
          "\r",
          "const base   = pm.variables.replaceIn('{{base}}');\r",
          "const uri    = pm.request.url.getPathWithQuery();   // PHẢI có query (?format=json)\r",
          "const method = pm.request.method;\r",
          "const user   = pm.environment.get('user');\r",
          "const pass   = pm.environment.get('pass');\r",
          "\r",
          "if (!user || !pass) {\r",
          "    console.error('Thiếu biến user/pass — kiểm tra environment');\r",
          "    return;\r",
          "}\r",
          "\r",
          "// Chặng 1: xin challenge\r",
          "pm.sendRequest({ url: base + uri, method: method }, function (err, res) {\r",
          "    if (err) { console.error('Không lấy được challenge:', err); return; }\r",
          "\r",
          "    const raw = res.headers.get('WWW-Authenticate');\r",
          "    if (!raw) { console.error('Thiết bị không trả WWW-Authenticate'); return; }\r",
          "\r",
          "    // Thiết bị có thể trả nhiều challenge trong 1 header → tách ra\r",
          "    const challenges = raw.split(/,?\\s*Digest\\s+/i).filter(s => s.trim());\r",
          "    const pick = (s, k) => (s.match(new RegExp(k + '\\\\s*=\\\\s*\"([^\"]*)\"', 'i')) || [])[1];\r",
          "\r",
          "    // Ưu tiên MD5; nếu không có thì lấy challenge đầu tiên\r",
          "    const ch = challenges.find(c => (pick(c, 'algorithm') || 'MD5').toUpperCase() === 'MD5')\r",
          "               || challenges[0];\r",
          "\r",
          "    const realm = pick(ch, 'realm');\r",
          "    const nonce = pick(ch, 'nonce');\r",
          "    const qop   = pick(ch, 'qop') || 'auth';\r",
          "    const algo  = (pick(ch, 'algorithm') || 'MD5').toUpperCase();  // thiếu = MD5 theo RFC\r",
          "\r",
          "    if (!realm || !nonce) { console.error('Challenge thiếu realm/nonce:', raw); return; }\r",
          "\r",
          "    // Chặng 2: tính response\r",
          "    const CryptoJS = require('crypto-js');\r",
          "    const H = s => (algo === 'SHA-256' ? CryptoJS.SHA256(s) : CryptoJS.MD5(s)).toString();\r",
          "\r",
          "    const nc     = '00000001';\r",
          "    const cnonce = CryptoJS.lib.WordArray.random(8).toString();\r",
          "\r",
          "    const HA1 = H(`${user}:${realm}:${pass}`);\r",
          "    const HA2 = H(`${method}:${uri}`);\r",
          "    const rsp = H(`${HA1}:${nonce}:${nc}:${cnonce}:${qop}:${HA2}`);\r",
          "\r",
          "    pm.request.headers.upsert({\r",
          "        key: 'Authorization',\r",
          "        value: `Digest username=\"${user}\", realm=\"${realm}\", nonce=\"${nonce}\", ` +\r",
          "               `uri=\"${uri}\", algorithm=${algo}, qop=${qop}, nc=${nc}, ` +\r",
          "               `cnonce=\"${cnonce}\", response=\"${rsp}\"`\r",
          "    });\r",
          "\r",
          "    console.log(`Digest OK → ${method} ${uri} | ${challenges.length} challenge | ${algo}`);\r",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
