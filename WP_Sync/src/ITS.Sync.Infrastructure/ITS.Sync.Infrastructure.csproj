<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tầng hạ tầng: SqlSugar (ORM) + provider SQLite runtime. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.216" />
    <!-- Messaging: tầng NATS RIÊNG của WP_Sync (không dùng Modules.DataTransporter). -->
    <PackageReference Include="NATS.Net" Version="2.7.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cần Abstractions/Models để listener kích hoạt đồng bộ theo tín hiệu. -->
    <ProjectReference Include="..\ITS.Sync.Core\ITS.Sync.Core.csproj" />
  </ItemGroup>

</Project>
