<Window x:Class="ITS.Sync.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ITS.Sync.Wpf.Views"
        xmlns:vm="clr-namespace:ITS.Sync.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="WP Sync - Giám sát đồng bộ" Height="680" Width="1080"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="LogList" TargetType="ListBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ HÀNG 1: TRẠNG THÁI + DB + ĐIỀU KHIỂN ============ -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Đèn trạng thái + tên trạng thái -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Thông tin DB nguồn/đích -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Nguồn: " Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SourceDbName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Đích: " Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TargetDbName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2" Content="Test kết nối" Command="{Binding TestConnectionCommand}" />
            </Grid>
        </Border>

        <!-- ============ HÀNG 2: CHU KỲ + NÚT + TIẾN ĐỘ ============ -->
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Chu kỳ (giây):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox   Grid.Column="1" Width="70" Height="26" VerticalContentAlignment="Center"
                       Text="{Binding CheckIntervalSeconds}" />
            <Button    Grid.Column="2" Content="Start"     Command="{Binding StartCommand}" Margin="12,0,3,0" />
            <Button    Grid.Column="3" Content="Stop"      Command="{Binding StopCommand}" />
            <Button    Grid.Column="4" Content="Chạy 1 lần" Command="{Binding RunOnceCommand}" />

            <!-- Thanh tiến độ + % -->
            <Grid Grid.Column="5" Margin="16,0,0,0">
                <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
        </Grid>

        <!-- ============ HÀNG 3: BẢNG ĐỒNG BỘ ============ -->
        <GroupBox Grid.Row="2" Header="Bảng đồng bộ (chọn 1 dòng để xem chi tiết bên dưới)">
            <DataGrid ItemsSource="{Binding Strategies}"
                      SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="All" Margin="2">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Bật" Binding="{Binding IsEnabled}" Width="45" />
                    <DataGridTextColumn Header="Tên bảng" Binding="{Binding TableName}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Thêm" Binding="{Binding Inserted}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Sửa" Binding="{Binding Updated}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Xóa" Binding="{Binding Deleted}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Không đổi" Binding="{Binding Unchanged}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="Lần chạy cuối" Binding="{Binding LastRunAt}" Width="130" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ============ HÀNG 4: LOG ============ -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Margin="0,0,3,0"
                      Header="{Binding SelectedStrategy.TableName, StringFormat='Chi tiết bảng: {0}', TargetNullValue='Chi tiết bảng (chọn 1 dòng ở trên)'}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Xóa log bảng này" HorizontalAlignment="Right"
                            Command="{Binding ClearLogCommand}" Margin="2" />
                    <ListBox Style="{StaticResource LogList}" ItemsSource="{Binding SelectedStrategy.Logs}" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Nhật ký chung (engine / test kết nối)" Margin="3,0,0,0">
                <ListBox Style="{StaticResource LogList}" ItemsSource="{Binding Control}" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
