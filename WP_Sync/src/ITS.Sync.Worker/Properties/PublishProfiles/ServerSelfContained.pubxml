<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile cho WP_Sync Worker khi deploy len may SERVER.
  SelfContained = true: dong goi kem .NET runtime nen may server KHONG can cai .NET.
  Cach dung: Right-click project -> Publish -> chon profile nay -> Publish
  Hoac: dotnet publish -p:PublishProfile=ServerSelfContained
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishUrl>bin\Publish\ServerSelfContained\</PublishUrl>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
