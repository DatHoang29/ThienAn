<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ITS.Sync.Worker-9b3dfc8f-4537-4d30-9552-4c2a4d6b5f18</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <!-- Cho phép chạy như Windows Service (hiện ở tab Services của Task Manager). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\ITS.Sync.Core\ITS.Sync.Core.csproj" />
	  <ProjectReference Include="..\ITS.Sync.Application\ITS.Sync.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configuration\Database.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- File xác thực NATS (bí mật) - cần có trong thư mục chạy để listener đọc được. -->
    <None Update="Configuration\camera.creds">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
