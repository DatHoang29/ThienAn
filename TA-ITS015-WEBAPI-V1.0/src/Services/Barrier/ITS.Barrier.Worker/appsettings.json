{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "FileDirectory": "Log",
    "RetainDays": 14
  },
  "AllowedHosts": "*",
  "Nats": {
    "Enabled": true,
    "Url": "nats://127.0.0.1:4222",
    "ClientName": "ITS_BARRIER_WORKER",
    "ControlSubject": "ta.its.control.barrier",
    "RetryIntervalSeconds": 5,
    "DeviceTimeoutSeconds": 10,
    "MaxParallelDevice": 4,
    "AuthMode": "NONE",
    "CredsFile": "Configuration/nats.creds"
  }
}
