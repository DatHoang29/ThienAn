<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ITS.Barrier.Worker</RootNamespace>
    <AssemblyName>ITS.Barrier.Worker</AssemblyName>
  </PropertyGroup>

  <!--
    ITS.Barrier.Worker: Host chạy nền (console hoặc Windows Service) cho dịch vụ điều khiển Barrier.
    - Lắng nghe kênh NATS ta.its.control.barrier, nhận Type="request", gọi S7-1200 / PLC, phát Type="result".
    - Endpoint /health để kiểm tra trạng thái sống.
    Author: ChuongLP
    Date: 05/10/2026
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITS.Barrier.Core\ITS.Barrier.Core.csproj" />
    <ProjectReference Include="..\..\..\Modules\Integration\Barrier\Modules.Integration.Barrier.Siemens\Modules.Integration.Barrier.Siemens.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Configuration\nats.creds">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
