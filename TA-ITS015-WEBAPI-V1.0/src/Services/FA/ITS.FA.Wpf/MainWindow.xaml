<Window x:Class="ITS.FA.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITS FA - FORM TEST BÁO CHÁY VÀ SỰ CỐ"
        Height="820" Width="1280" WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Trạng thái kết nối -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="ITS FA TEST" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DatabaseText}" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding NatsText}" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Điều khiển phiên quét -->
        <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <CheckBox Content="Dùng tủ giả" IsChecked="{Binding UseSimulator}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="IP tủ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding PanelIp}" Width="120" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Cổng" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding PanelPort}" Width="60" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="Bắt đầu" Command="{Binding StartCommand}" Padding="14,5" Margin="0,0,6,0"/>
                <Button Content="Dừng" Command="{Binding StopCommand}" Padding="14,5" Margin="0,0,14,0"/>
                <Button Content="Nạp lại danh sách" Command="{Binding ReloadCommand}" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="Tạo dữ liệu mẫu" Command="{Binding SeedSampleCommand}" Padding="10,5" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding MonitorText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Tủ báo cháy -->
            <GroupBox Grid.Column="0" Header=" 1. Tủ báo cháy: bật tín hiệu rồi xem cột DB " Margin="0,0,6,0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox Content="Báo cháy chưa rõ nguồn" IsChecked="{Binding UnknownFire}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="Reset tủ" Command="{Binding ResetPanelCommand}" Padding="12,4"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              RowHeaderWidth="0" SelectionMode="Single" BorderBrush="#CBD5E1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tín hiệu" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsTriggered, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Vị trí" Binding="{Binding Position}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="DB" Binding="{Binding DbState}" IsReadOnly="True" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- Sự cố -->
            <GroupBox Grid.Column="1" Header=" 2. Sự cố nguồn FA trong TmsIncident " Margin="6,0,0,0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Kết thúc sự cố đang chọn" Command="{Binding FinishIncidentCommand}" Padding="12,4"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}" AutoGenerateColumns="False"
                              IsReadOnly="True" RowHeaderWidth="0" SelectionMode="Single" BorderBrush="#CBD5E1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="*"/>
                            <DataGridTextColumn Header="Km" Binding="{Binding KmNumber}" Width="40"/>
                            <DataGridTextColumn Header="Mét" Binding="{Binding MetNumber}" Width="45"/>
                            <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="45"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="45"/>
                            <DataGridTextColumn Header="Vùng" Binding="{Binding ZoneId}" Width="90"/>
                            <DataGridTextColumn Header="Camera" Binding="{Binding EquipmentId}" Width="90"/>
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat='dd/MM HH:mm:ss'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header=" 3. Bản tin NATS nhận được " Margin="0,0,6,0">
                <ListBox ItemsSource="{Binding NatsMessages}" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
            </GroupBox>
            <GroupBox Grid.Column="1" Header=" 4. Log dịch vụ " Margin="6,0,0,0">
                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
