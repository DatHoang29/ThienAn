<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Services.CctvProxy.Worker</RootNamespace>
  </PropertyGroup>

  <!--
    Services.CctvProxy.Worker: host HTTP/WebSocket (Kestrel) cho Cctv Proxy.
    FE kết nối WebRTC / tải video qua đây thay vì trực tiếp NxVMS; tài khoản NxVMS chỉ nằm ở BE.
    Chạy được cả console (dotnet run) lẫn Windows Service (sc create).
  -->

  <ItemGroup>
    <ProjectReference Include="..\Services.CctvProxy\Services.CctvProxy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configuration\Database.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Configuration\Logging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
