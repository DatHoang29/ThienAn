<UserControl x:Class="ITS.VMS.Wpf.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <!-- ============ HÀNG 1: CẤU HÌNH (chỉ đọc, sửa trong appsettings.json mục Telemetry) ============ -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <WrapPanel>
                <TextBlock Text="Kênh dữ liệu:" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="180" Margin="6,0,16,0" VerticalAlignment="Center" IsReadOnly="True"
                         Text="{Binding DataSubject, Mode=OneWay}"
                         ToolTip="Kênh dùng chung 3 loại gói: equipment-request / equipment-result / telemetry" />

                <TextBlock Text="Chu kỳ (phút):" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="45" Margin="6,0,16,0" VerticalAlignment="Center"
                         Text="{Binding CollectIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Đổi ở đây chỉ có tác dụng cho lần bật vòng lặp tiếp theo" />

                <TextBlock Text="Loại thiết bị:" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="110" Margin="6,0,16,0" VerticalAlignment="Center" IsReadOnly="True"
                         Text="{Binding DeviceTypeText, Mode=OneWay}" />

                <TextBlock Text="Thông số đọc:" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="260" Margin="6,0,16,0" VerticalAlignment="Center" IsReadOnly="True"
                         Text="{Binding StatTypeText, Mode=OneWay}"
                         ToolTip="Telemetry:StatTypes — để trống là đọc tất cả" />

                <TextBlock Text="Đọc song song:" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="40" Margin="6,0,0,0" VerticalAlignment="Center" IsReadOnly="True"
                         Text="{Binding MaxParallelDevice, Mode=OneWay}" />
            </WrapPanel>
        </Border>

        <!-- ============ HÀNG 2: NÚT THAO TÁC ============ -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
            <Button Content="1. Đồng bộ thiết bị" Command="{Binding SyncEquipmentCommand}"
                    Width="150" Background="#B3E5FC" FontWeight="Bold" IsEnabled="{Binding CanRun}"
                    ToolTip="Hỏi BE danh sách thiết bị VMS/LCS rồi lưu ra file State\vms_equipment.json" />

            <Button Content="2. Quét telemetry ngay" Command="{Binding CollectNowCommand}"
                    Width="170" Background="#C8E6C9" FontWeight="Bold" IsEnabled="{Binding CanRun}"
                    ToolTip="Đọc thông số toàn bộ thiết bị một lượt rồi đẩy về BE lưu DB" />

            <Button Width="180" Margin="16,0,0,0" Command="{Binding ToggleAutoCommand}" Background="#FFE0B2"
                    ToolTip="Chạy tự động theo chu kỳ — đúng cách ITS.VMS.Worker sẽ chạy ngoài site">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="3. Bật vòng lặp tự động" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoRunning}" Value="True">
                                    <Setter Property="Text" Value="3. Tắt vòng lặp tự động" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <Button Content="Xóa kết quả" Command="{Binding ClearResultsCommand}" Width="100" Margin="16,0,0,0" />
        </WrapPanel>

        <!-- ============ HÀNG 3: TRẠNG THÁI ============ -->
        <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#DDD" BorderThickness="1" Padding="10"
                CornerRadius="4" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="{Binding AutoStateText}" FontWeight="Bold" Foreground="#E65100" />
                <TextBlock Text="{Binding EquipmentStatus}" Margin="0,4,0,0" Foreground="#0D47A1" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BufferStatus}" Margin="0,2,0,0" Foreground="#4A148C" />
                <TextBlock Text="{Binding LastCollectSummary}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Foreground="#888" TextWrapping="Wrap"
                           Text="Thứ tự test ngoài site: bấm (1) để lấy danh sách thiết bị thật từ BE → kiểm tra lưới dưới xem Ip/Port/Config đúng chưa → bấm (2) quét thử một lượt và đối chiếu thông số với thiết bị → chạy đúng rồi thì bấm (3) để theo dõi liên tục." />
            </StackPanel>
        </Border>

        <!-- ============ HÀNG 4: DANH SÁCH THIẾT BỊ ĐÃ ĐỒNG BỘ ============ -->
        <GroupBox Grid.Row="3" Header="Thiết bị đã đồng bộ từ BE (chỉ đọc — sửa trên giao diện BE rồi bấm Đồng bộ lại)"
                  Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding Equipments}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All" Margin="2">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <!-- Thiếu Vendor/Ip thì tô đỏ nhạt: đây là thiết bị sẽ luôn báo lỗi khi quét -->
                            <DataTrigger Binding="{Binding Ready}" Value="False">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110" />
                    <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="1.4*" />
                    <DataGridTextColumn Header="Loại" Binding="{Binding TypeCode}" Width="55" />
                    <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="85" />
                    <DataGridTextColumn Header="Ip" Binding="{Binding Ip}" Width="115" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="50" />
                    <DataGridTextColumn Header="Config" Binding="{Binding Config}" Width="2*" />
                    <DataGridTextColumn Header="Sẵn sàng" Binding="{Binding ReadyText}" Width="70" />
                    <DataGridTextColumn Header="EquipmentId" Binding="{Binding EquipmentId}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ============ HÀNG 5: KẾT QUẢ LƯỢT QUÉT ============ -->
        <GroupBox Grid.Row="4" Header="Kết quả lượt quét gần nhất (đối chiếu cột Thông số với thiết bị thật)"
                  Margin="0,8,0,0">
            <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All" Margin="2">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Success}" Value="False">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110" />
                    <DataGridTextColumn Header="KQ" Binding="{Binding State}" Width="55" />
                    <DataGridTextColumn Header="Số thông số" Binding="{Binding StatCount}" Width="80" />
                    <DataGridTextColumn Header="Thông số đọc được" Binding="{Binding Stats}" Width="2.5*" />
                    <DataGridTextColumn Header="Thông báo" Binding="{Binding Message}" Width="1.5*" />
                    <DataGridTextColumn Header="EquipmentId" Binding="{Binding EquipmentId}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
