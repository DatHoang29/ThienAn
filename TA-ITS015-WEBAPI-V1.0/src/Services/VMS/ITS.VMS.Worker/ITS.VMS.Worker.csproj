<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ITS.VMS.Worker</RootNamespace>
    <AssemblyName>ITS.VMS.Worker</AssemblyName>
  </PropertyGroup>

  <!--
    ITS.VMS.Worker: host chạy nền (console hoặc Windows Service) cho dịch vụ điều khiển bảng VMS.
    - Lắng nghe kênh NATS ta.its.control.vms, nhận Type="request", gọi SDK thiết bị, phát Type="result".
    - Chỉ có 1 endpoint /health để kiểm tra sống; KHÔNG mở API nghiệp vụ nào.
    - Toàn bộ logic nằm ở ITS.VMS.Core để sau này bọc lại bằng form WPF nếu cần.

    LƯU Ý: mục đích chính của dịch vụ này là CÔ LẬP SDK native (czVMSII/czJetFileII/Snmp) khỏi tiến trình WebAPI.
    Nếu SDK lỗi bộ nhớ hoặc crash thì chỉ sập Worker, WebAPI vẫn chạy.
  -->

  <ItemGroup>
    <!-- Cho phép chạy như Windows Service (hiện ở tab Services). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITS.VMS.Core\ITS.VMS.Core.csproj" />
    <!--
      2 project driver dưới đây KHÔNG được gọi trực tiếp trong code (VmsDeviceExecutor nạp bằng Assembly.LoadFrom).
      Tham chiếu ở đây CHỈ để MSBuild copy DLL driver + toàn bộ dependency (Shared.Utility, Newtonsoft...) vào
      thư mục chạy. Bỏ tham chiếu này thì Assembly.LoadFrom sẽ lỗi thiếu assembly phụ thuộc lúc runtime.
    -->
    <ProjectReference Include="..\..\..\Modules\Integration\VMS\Modules.Integration.VMS.Chainzone\Modules.Integration.VMS.Chainzone.csproj" />
    <ProjectReference Include="..\..\..\Modules\Integration\VMS\Modules.Integration.Vms.Dysten\Modules.Integration.Vms.Dysten.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- File xác thực NATS (bí mật) - cần có trong thư mục chạy để listener đọc được. -->
    <None Update="Configuration\nats.creds">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    Native DLL của SDK Chainzone (czVMSII = kênh SDK, czJetFileII* = kênh API dùng P/Invoke).
    Các project Adapter KHÔNG tự khai báo copy nên phải copy thẳng cạnh exe ở đây:
    Assembly.LoadFrom và DllImport đều tìm theo thư mục của TIẾN TRÌNH đang chạy.

    ĐÂY LÀ LINK, KHÔNG PHẢI BẢN SAO — file gốc vẫn nằm trong Adapter\DllApi và Adapter\DllSdk.
    Visible=false để Solution Explorer không vẽ chúng ở gốc project cho đỡ rối;
    XOÁ khối này thì DLL không được copy sang bin và RegisterModule sẽ báo VendorDllNotFound.
  -->
  <ItemGroup>
    <None Include="..\..\..\Modules\Integration\VMS\Chainzone\Modules.Integration.VMS.Chainzone.Adapter\DllApi\*.dll"
          Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\..\Modules\Integration\VMS\Chainzone\Modules.Integration.VMS.Chainzone.Adapter\DllSdk\*.dll"
          Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
