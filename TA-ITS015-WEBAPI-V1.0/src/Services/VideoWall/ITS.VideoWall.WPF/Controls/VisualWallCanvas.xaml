<UserControl x:Class="Module.VideoWall.WPF.Controls.VisualWallCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="700">
    <Grid Background="#0B1120" ClipToBounds="True" x:Name="RootContainerGrid" MinHeight="250" SizeChanged="OnRootContainerSizeChanged">
        <!-- Canvas Vùng Vẽ Tường Ghép Trực Quan -->
        <Canvas x:Name="WallViewportCanvas"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#0F172A"
                ClipToBounds="False">
            
            <!-- 1. LỚP NỀN: MÔ PHỎNG CÁC MÀN HÌNH VẬT LÝ CỦA TƯỜNG (PHYSICAL SCREENS) -->
            <Canvas x:Name="PhysicalScreensCanvas" IsHitTestVisible="False" />

            <!-- 2. LỚP TIÊU ĐIỂM: CÁC Ô CAMERA KÉO THẢ TƯƠNG TÁC (INTERACTIVE WINDOWS) -->
            <Canvas x:Name="InteractiveWindowsCanvas" />
        </Canvas>

        <!-- Thanh thông tin thu nhỏ tỉ lệ ở góc dưới bên trái -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="#90000000" CornerRadius="3" Padding="6,3" Margin="8">
            <TextBlock x:Name="ScaleInfoText" Text="📐 Tỉ lệ Preview: 100% · Lưới chuẩn 1920px"
                       FontSize="10" Foreground="#94A3B8" FontFamily="Consolas" />
        </Border>

        <!-- Trạng thái trống khi chưa có kịch bản hoặc chưa có màn hình -->
        <StackPanel x:Name="EmptyOverlay"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="📺 Chưa có kịch bản hoặc chưa kết nối thiết bị"
                       HorizontalAlignment="Center" FontWeight="SemiBold"
                       Foreground="#64748B" FontSize="13" Margin="0,0,0,4" />
            <TextBlock Text="Bấm '➕ Thêm ô camera' hoặc chọn Kịch bản ở trên để bắt đầu dựng bố cục."
                       HorizontalAlignment="Center" Foreground="#475569" FontSize="11" />
        </StackPanel>
    </Grid>
</UserControl>
