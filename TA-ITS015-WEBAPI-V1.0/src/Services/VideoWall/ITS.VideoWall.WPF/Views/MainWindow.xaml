<Window x:Class="Module.VideoWall.WPF.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Module.VideoWall.WPF.Views"
        xmlns:interaction="clr-namespace:Module.VideoWall.WPF.Interaction"
        Title="Video Wall — ThienAn"
        Width="1280"
        Height="860"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <interaction:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <interaction:NullToVisibilityConverter x:Key="NullToVisibility" />
        <interaction:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility" />
        <interaction:StatusColorConverter x:Key="StatusColorConverter" />
        <interaction:BoolToStatusBackgroundConverter x:Key="BoolToStatusBackgroundConverter" />
        <interaction:BoolToStatusForegroundConverter x:Key="BoolToStatusForegroundConverter" />

        <!-- Style ToolTip chuẩn: tự động ngắt dòng và giới hạn độ rộng trong MainWindow, không tràn màn hình -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TabItem hiện đại, có viền bo tròn, padding thoáng và hiển thị rõ nét -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#EDF2F7"
                                BorderBrush="#CBD5E0"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="10,5"
                                Margin="0,0,3,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3182CE" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0" />
                                <Setter TargetName="TabBorder" Property="Margin" Value="0,0,3,-1" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                                <Setter Property="Foreground" Value="#2B6CB0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#4A5568" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ActivityRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success">
                    <Setter Property="Foreground" Value="#1B7F3B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="#B8860B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="#C0392B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style badge phương thức HTTP -->
        <Style x:Key="MethodBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="GET">
                    <Setter Property="Background" Value="#EBF8FF" />
                    <Setter Property="BorderBrush" Value="#3182CE" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="POST">
                    <Setter Property="Background" Value="#F0FFF4" />
                    <Setter Property="BorderBrush" Value="#38A169" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="PUT">
                    <Setter Property="Background" Value="#FFFAF0" />
                    <Setter Property="BorderBrush" Value="#DD6B20" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="DELETE">
                    <Setter Property="Background" Value="#FFF5F5" />
                    <Setter Property="BorderBrush" Value="#E53E3E" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Row 0: Header kết nối trực tiếp & Action buttons -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Khung làm việc chính: 13 Tab nhóm API & Kịch bản (Tự động chiếm toàn bộ không gian) -->
            <RowDefinition Height="*" MinHeight="180" />
            <!-- Row 2: GridSplitter kéo dãn giữa TabControl và Log -->
            <RowDefinition Height="5" />
            <!-- Row 3: Khung Log hoạt động (Chiều cao gọn gàng ~150px, có thể kéo dãn) -->
            <RowDefinition Height="150" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header kết nối trực tiếp (IP, Port, Account, Password, WallNo, Ping) & Action buttons -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,3"
                Margin="0,0,0,6">
            <!-- Các ô nhập IP, Port, Account, Password, WallNo, Ping, StatusMessage -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Connection}">
                <!-- Radio chọn nhanh thiết bị thật hoặc giả lập -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,12,1">
                    <RadioButton Content="🎯 Test thiết bị thật"
                                 GroupName="TargetDeviceGroup"
                                 IsChecked="{Binding IsRealDeviceSelected}"
                                 FontWeight="Bold"
                                 Foreground="#1E40AF"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 ToolTip="Điền thông tin bộ điều khiển trung tâm: Port 80, Account admin, Password Tcp@2025 (nhập IP thiết bị thật)" />
                    <RadioButton Content="💻 Giả lập (Local)"
                                 GroupName="TargetDeviceGroup"
                                 IsChecked="{Binding IsLocalMockSelected}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 ToolTip="Tự động điền cấu hình giả lập: IP 127.0.0.1, Port 18080, Account admin, Password Password123!" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,8,1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="IP" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Width="110" Height="21" VerticalAlignment="Center" Padding="4,1" Text="{Binding AdHocIp, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,8,1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Port" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Width="45" Height="21" VerticalAlignment="Center" Padding="4,1" Text="{Binding AdHocPort, TargetNullValue=''}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,8,1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Account" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Width="80" Height="21" VerticalAlignment="Center" Padding="4,1" Text="{Binding AdHocAccount}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,8,1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Grid Height="21" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="AdHocPasswordInput"
                                     Grid.Column="0"
                                     Height="21"
                                     VerticalAlignment="Center"
                                     Padding="4,1"
                                     PasswordChanged="OnAdHocPasswordChanged" />
                        <TextBox x:Name="AdHocPasswordVisibleInput"
                                 Grid.Column="0"
                                 Height="21"
                                 VerticalAlignment="Center"
                                 Padding="4,1"
                                 Visibility="Collapsed"
                                 TextChanged="OnAdHocPasswordVisibleTextChanged" />
                        <Button x:Name="TogglePasswordBtn"
                                Grid.Column="1"
                                Content="👁"
                                Width="22"
                                Height="21"
                                Padding="0"
                                Margin="2,0,0,0"
                                FontSize="11"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#EDF2F7"
                                BorderBrush="#CBD5E0"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnTogglePasswordVisibility"
                                ToolTip="Hiện mật khẩu" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,10,1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="WallNo" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Grid Margin="0,0,8,0" Height="21">
                        <ComboBox x:Name="WallCombo"
                                  ItemsSource="{Binding Walls}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding WallNo, UpdateSourceTrigger=PropertyChanged, TargetNullValue={x:Null}}"
                                  MinWidth="260"
                                  Width="280"
                                  Height="21"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding HasProbeWalls}"
                                  ToolTip="Chọn tường sau khi bấm Khảo sát (Probe). Trước khi Probe chưa có dữ liệu để chọn.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name, StringFormat=' — {0}'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="— Chưa chọn tường — bấm 🔍 Khảo sát (Probe) —"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="8,0,24,0"
                                   Foreground="#A0AEC0"
                                   FontStyle="Italic"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding WallNo, Converter={StaticResource InverseNullToVisibility}}" />
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectCommand}"
                            Content="🔌 Kết nối &amp; Khảo sát"
                            MinWidth="135"
                            Height="21"
                            Padding="8,1"
                            FontWeight="SemiBold"
                            Margin="0,0,6,0">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock Text="Kết nối và khảo sát thiết bị: tự động kiểm tra mạng, đăng nhập Digest và đồng bộ toàn bộ danh sách tường, cổng ra màn hình, nguồn tín hiệu, kịch bản và bố cục cửa sổ từ phần cứng."
                                            TextWrapping="Wrap" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ProbeCommand}"
                            Content="🔄 Khảo sát lại"
                            MinWidth="95"
                            Height="21"
                            Padding="8,1"
                            Margin="0,0,6,0">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="350">
                                <TextBlock Text="Khảo sát lại thiết bị: tự động đồng bộ lại toàn bộ thông số tường, cổng ra màn hình, nguồn tín hiệu, danh sách kịch bản và các ô cửa sổ đang chiếu."
                                            TextWrapping="Wrap" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Row 1: Khung làm việc chính: TabControl + Khung Response cho Tab ISAPI -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Row 0: 13 Tab nhóm API & Kịch bản -->
                <RowDefinition Height="2*" MinHeight="150" />
                <!-- Row 1: GridSplitter kéo dãn giữa TabControl và Response (Chỉ hiện khi IsResponseVisible = True) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Khung Response (Chỉ hiện khi IsResponseVisible = True) -->
                <RowDefinition Height="{Binding ResponseRowHeight, Mode=TwoWay}" />
            </Grid.RowDefinitions>

            <!-- TabControl 13 tab: Disable và mờ nhẹ khi chưa kết nối, tự sáng rõ sau khi bấm 'Kết nối & Khảo sát' thành công -->
            <TabControl Grid.Row="0"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        IsEnabled="{Binding Connection.IsConnected}">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0"
                                       Panel.ZIndex="1"
                                       IsItemsHost="True"
                                       KeyboardNavigation.TabIndex="1"
                                       Background="Transparent" />
                            <!-- Border bao bọc phần nội dung từng Tab -->
                            <Border Grid.Row="1"
                                    Panel.ZIndex="0"
                                    BorderThickness="1,1,1,0"
                                    BorderBrush="#D2D6DC"
                                    Background="#FFFFFF"
                                    CornerRadius="0,4,0,0"
                                    Margin="0,-1,0,0">
                                <ContentPresenter ContentSource="SelectedContent" Margin="4,4,4,0" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Tab 1: Thiết lập Kịch bản & Bố cục (Màn hình làm việc chính) -->
                <TabItem Header="1. Thiết lập Kịch bản &amp; Bố cục">
                    <views:SceneSetupTabView DataContext="{Binding SceneSetup}" />
                </TabItem>

                <!-- Tab 2..12: 11 Direct ISAPI Function Groups (Pure English) -->
                <TabItem Header="2. Board">
                    <views:IsapiGroupTabView Group="Board" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="3. Decoding">
                    <views:IsapiGroupTabView Group="Decoding" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="4. Output Channel">
                    <views:IsapiGroupTabView Group="OutputChannel" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="5. Signal Source">
                    <views:IsapiGroupTabView Group="SignalSource" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="6. Video Wall">
                    <views:IsapiGroupTabView Group="VideoWall" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="7. Plan">
                    <views:IsapiGroupTabView Group="Plan" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="8. Scene">
                    <views:IsapiGroupTabView Group="Scene" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="9. Screen">
                    <views:IsapiGroupTabView Group="Screen" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="10. Text LED">
                    <views:IsapiGroupTabView Group="TextLed" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="11. Wallpaper">
                    <views:IsapiGroupTabView Group="Wallpaper" DataContext="{Binding Connection}" />
                </TabItem>
                <TabItem Header="12. Window">
                    <views:IsapiGroupTabView Group="Window" DataContext="{Binding Connection}" />
                </TabItem>
            </TabControl>

            <!-- Row 1: GridSplitter kéo dãn giữa TabControl và Response (Chỉ hiện ở Tab 3..13) -->
            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Height="3"
                          Background="#D2D6DC"
                          Cursor="SizeNS"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Visibility="{Binding IsResponseVisible, Converter={StaticResource BoolToVisibility}}" />

            <!-- Row 2: Khung Response cố định bên dưới TabControl (Chỉ hiện ở Tab 3..13) -->
            <Border Grid.Row="2"
                    BorderThickness="1,0,1,0"
                    BorderBrush="#D2D6DC"
                    Background="#FFFFFF"
                    Padding="6,4"
                    DataContext="{Binding Connection}"
                    Visibility="{Binding DataContext.IsResponseVisible, ElementName=RootWindow, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header Row: Title, Main Status Badge, Context Badges, and Copy Action -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title & Main Status Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Phản hồi thiết bị (Response)"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       FontSize="12"
                                       VerticalAlignment="Center" />

                            <Border Margin="8,0,0,0"
                                    Background="{Binding IsapiResponseSuccess, Converter={StaticResource BoolToStatusBackgroundConverter}}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasIsapiResponse, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding IsapiResponseStatusBadge}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding IsapiResponseSuccess, Converter={StaticResource BoolToStatusForegroundConverter}}" />
                            </Border>
                        </StackPanel>

                        <!-- Center: Detail Insight Badges -->
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding IsapiResponseBadges}"
                                      Margin="8,0"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Margin="3,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="#334155" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Right: Copy Button -->
                        <Button Grid.Column="2"
                                Command="{Binding CopyIsapiResponseCommand}"
                                Content="📋 Sao chép"
                                ToolTip="Sao chép toàn bộ XML phản hồi vào Clipboard"
                                Style="{StaticResource ToolbarButton}"
                                Height="22"
                                MinWidth="75"
                                FontSize="11"
                                Margin="0"
                                Padding="6,1"
                                Visibility="{Binding HasIsapiResponse, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- XML View with Syntax Highlighting & Status Highlights -->
                    <RichTextBox Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#F8FAFC"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="4"
                                 interaction:XmlHighlightingBehavior.XmlText="{Binding IsapiResponse}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Thanh kéo dãn giữa TabControl và Log (Thin divider) -->
        <GridSplitter Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Height="2"
                      Background="#E2E8F0"
                      Cursor="SizeNS"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" />

        <!-- Row 3: Khung Log cố định ở cuối cửa sổ (Không viền top vì có GridSplitter, bo góc đáy) -->
        <Border Grid.Row="3"
                BorderThickness="1,0,1,1"
                BorderBrush="#D2D6DC"
                Background="#FFFFFF"
                CornerRadius="0,0,4,4"
                Padding="6,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Logs"
                               FontWeight="SemiBold"
                               Foreground="#4A5568"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ClearActivitiesCommand}"
                            Content="Xoá log"
                            Height="18"
                            Padding="6,0"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ExportLogCommand}"
                            Content="Xuất log"
                            Height="18"
                            Padding="6,0"
                            FontSize="11"
                            ToolTip="Lưu log của phiên đang chạy ra file JSON (.json) trên máy — không cần đăng nhập, không gọi server." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <DataGrid Style="{StaticResource ReadOnlyGrid}"
                              RowStyle="{StaticResource ActivityRow}"
                              FontFamily="Consolas"
                              FontSize="12"
                              ItemsSource="{Binding Activities}"
                              MouseDoubleClick="OnViewActivityDetails"
                              SelectedItem="{Binding SelectedActivity}"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Width="110" Binding="{Binding TimestampLocal, Mode=OneWay, StringFormat=HH:mm:ss.fff}" />
                            <DataGridTextColumn Header="Nhóm" Width="90" Binding="{Binding Stage, Mode=OneWay}" />
                            <DataGridTextColumn Header="Mức" Width="70" Binding="{Binding Level, Mode=OneWay}" />
                            <DataGridTextColumn Header="Chi tiết" Width="*" Binding="{Binding Detail, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="#FAFAFA"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Visibility="{Binding HasActivities, Converter={StaticResource InverseBoolToVisibility}}"
                            IsHitTestVisible="False">
                        <TextBlock Text="Chưa có hoạt động nào được ghi nhận."
                                   FontStyle="Italic"
                                   Foreground="#A0AEC0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>