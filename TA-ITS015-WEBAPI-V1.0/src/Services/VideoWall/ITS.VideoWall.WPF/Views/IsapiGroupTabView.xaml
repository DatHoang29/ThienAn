<UserControl x:Class="Module.VideoWall.WPF.Views.IsapiGroupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:interaction="clr-namespace:Module.VideoWall.WPF.Interaction"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Style badge phương thức HTTP cho item danh sách bên trái -->
        <Style x:Key="MethodBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Method}" Value="GET">
                    <Setter Property="Background" Value="#EBF8FF" />
                    <Setter Property="BorderBrush" Value="#3182CE" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Method}" Value="POST">
                    <Setter Property="Background" Value="#F0FFF4" />
                    <Setter Property="BorderBrush" Value="#38A169" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Method}" Value="PUT">
                    <Setter Property="Background" Value="#FFFAF0" />
                    <Setter Property="BorderBrush" Value="#DD6B20" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Method}" Value="DELETE">
                    <Setter Property="Background" Value="#FFF5F5" />
                    <Setter Property="BorderBrush" Value="#E53E3E" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style badge phương thức cho thanh Gửi ISAPI (khác MethodBadge — cái đó dùng cho item danh sách API bên trái) -->
        <Style x:Key="ExecMethodBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="GET">
                    <Setter Property="Background" Value="#EBF8FF" />
                    <Setter Property="BorderBrush" Value="#3182CE" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="POST">
                    <Setter Property="Background" Value="#F0FFF4" />
                    <Setter Property="BorderBrush" Value="#38A169" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="PUT">
                    <Setter Property="Background" Value="#FFFAF0" />
                    <Setter Property="BorderBrush" Value="#DD6B20" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsapiMethod}" Value="DELETE">
                    <Setter Property="Background" Value="#FFF5F5" />
                    <Setter Property="BorderBrush" Value="#E53E3E" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Template hiển thị từng trường Path Parameter gọn gàng theo chiều ngang -->
        <DataTemplate x:Key="FieldItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Label}" FontWeight="Medium" Foreground="#2D3748" VerticalAlignment="Center" />
                    <TextBlock Text=" *" Foreground="#E53E3E" FontWeight="Bold" VerticalAlignment="Center"
                               Visibility="{Binding Definition.Required, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Trường có danh sách lựa chọn (Enum) -->
                <ComboBox ItemsSource="{Binding Definition.Options}"
                          SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Width="130"
                          Height="24"
                          Padding="4,2"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" />

                <!-- Trường nhập tự do (String / Int / Bool không có Options cố định) -->
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding Definition.ReadOnly}"
                         Width="130"
                         Height="24"
                         Padding="4,2"
                         VerticalAlignment="Center"
                         Visibility="{Binding HasNoOptions, Converter={StaticResource BoolToVisibility}}" />

                <!-- Báo lỗi validation nếu có -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53E3E" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <!-- Cột trái: Danh sách API trong nhóm -->
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="3" />
            <!-- Cột phải: Form nhập tham số động -->
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- 1. Danh sách API trong nhóm -->
        <Border Grid.Column="0"
                BorderThickness="1,1,0,1"
                BorderBrush="#D2D6DC"
                Background="#FFFFFF"
                CornerRadius="4,0,0,4"
                Padding="6,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="API List" FontWeight="Bold" Foreground="#2D3748" FontSize="13" Margin="0,0,0,4" />
                <Grid Grid.Row="1">
                    <ListBox x:Name="ApiListBox"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4">
                                    <Border Style="{StaticResource MethodBadge}" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Method}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Section}" FontWeight="SemiBold" FontSize="12" Foreground="#2B6CB0" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" Foreground="#4A5568" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="#FAFAFA"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ApiListBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="(No APIs in this group)"
                                   FontStyle="Italic"
                                   Foreground="#A0AEC0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Splitter between API list and Form -->
        <GridSplitter Grid.Column="1"
                      Width="2"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#D2D6DC"
                      Cursor="SizeWE"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False" />

        <!-- 2. Selected API Parameter Form -->
        <Border Grid.Column="2"
                BorderThickness="0,1,1,1"
                BorderBrush="#D2D6DC"
                Background="#FFFFFF"
                CornerRadius="0,4,4,0"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="API Parameters" FontWeight="Bold" Foreground="#2D3748" FontSize="13" Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 0. Send ISAPI Toolbar: Method + Endpoint + Send Button -->
                        <DockPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource ExecMethodBadge}" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IsapiMethod}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource ToolbarButton}" Command="{Binding SendIsapiCommand}" Content="Send ISAPI"
                                    Height="26" FontWeight="SemiBold" DockPanel.Dock="Right" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Endpoint:" Margin="8,0,4,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBox Text="{Binding IsapiPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#FFFFFF" FontFamily="Consolas" FontSize="12" Height="26" Padding="6,4"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- A. Path Parameters -->
                        <GroupBox Header="Path Parameters" Margin="0,0,0,8" Padding="8,6"
                                  Visibility="{Binding ActiveIsapiForm.HasPathFields, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ActiveIsapiForm.PathFields}" ItemTemplate="{StaticResource FieldItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </GroupBox>

                        <!-- B. Request Body — Auto-visible when Method is POST or PUT -->
                        <GroupBox Header="Request Body (JSON/XML)" Padding="8" Margin="0,0,0,10"
                                  Visibility="{Binding IsBodyRequired, Converter={StaticResource BoolToVisibility}}">
                            <RichTextBox interaction:XmlHighlightingBehavior.XmlText="{Binding ActiveIsapiForm.RawBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         interaction:XmlHighlightingBehavior.EnableTwoWay="True"
                                         AcceptsReturn="True"
                                         Height="220"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Background="#F8FAFC"
                                         BorderBrush="#E2E8F0"
                                         BorderThickness="1"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="6" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
