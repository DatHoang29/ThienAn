<Window x:Class="ITS.Toll.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOLL — Test API thu phí (ETC)" Height="780" Width="1120"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- Một dòng nhật ký: giờ + nội dung, tô màu theo mức -->
        <DataTemplate x:Key="LogRow">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TimeText}" Foreground="#616161" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Foreground" Value="#E65100" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Foreground" Value="#B71C1C" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                    <Setter Property="Foreground" Value="#1B5E20" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="0.8*" />
        </Grid.RowDefinitions>

        <!-- ============ HÀNG 1: CẤU HÌNH CHUNG ============ -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <WrapPanel>
                <TextBlock Text="BaseUrl:" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="360" Margin="6,0,16,0" VerticalAlignment="Center"
                         Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Dùng khi Url của API là đường dẫn tương đối" />

                <TextBlock Text="Timeout (giây):" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="50" Margin="6,0,16,0" VerticalAlignment="Center"
                         Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Định dạng ngày:" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="150" Margin="6,0,16,0" VerticalAlignment="Center"
                         Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Chu kỳ tự động (giây):" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBox Width="60" Margin="6,0,0,0" VerticalAlignment="Center"
                         Text="{Binding AutoCallIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
        </Border>

        <!-- ============ HÀNG 2: KHOẢNG THỜI GIAN + NÚT ============ -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,8" VerticalAlignment="Center">
            <TextBlock Text="FromDate:" VerticalAlignment="Center" FontWeight="Bold" />
            <TextBox Width="150" Margin="6,0,16,0" VerticalAlignment="Center"
                     Text="{Binding FromDate, StringFormat='yyyy-MM-dd HH:mm:ss', UpdateSourceTrigger=LostFocus}"
                     ToolTip="Chỉ dùng cho API có 'Cần khoảng ngày' = true" />

            <TextBlock Text="ToDate:" VerticalAlignment="Center" FontWeight="Bold" />
            <TextBox Width="150" Margin="6,0,16,0" VerticalAlignment="Center"
                     Text="{Binding ToDate, StringFormat='yyyy-MM-dd HH:mm:ss', UpdateSourceTrigger=LostFocus}" />

            <Button Content="Gọi API đang chọn" Command="{Binding CallSelectedApiCommand}"
                    Width="150" Background="#C8E6C9" FontWeight="Bold" />
            <Button Content="Gọi tất cả" Command="{Binding CallAllApisCommand}"
                    Width="100" Margin="6,0,0,0" Background="#B3E5FC" />
            <CheckBox Content="Lưu vào DB sau khi gọi" IsChecked="{Binding SaveToDb}"
                      VerticalAlignment="Center" Margin="12,0,4,0"
                      ToolTip="Bật: sau khi gọi thành công sẽ lưu dữ liệu xuống DB ITS (hiện hỗ trợ masterdata)" />
            <Button Content="Bật/Tắt tự động" Command="{Binding ToggleAutoCallCommand}"
                    Width="120" Margin="16,0,0,0" Background="#FFE0B2"
                    ToolTip="Tự động gọi tất cả API đang bật theo chu kỳ cấu hình" />
            <Button Content="Lưu cấu hình" Command="{Binding SaveConfigCommand}"
                    Width="110" Margin="6,0,0,0" Background="#DCEDC8"
                    ToolTip="Lưu BaseUrl, danh sách API, chu kỳ... xuống file TollTest.json" />
            <TextBlock Text="{Binding AutoStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontWeight="SemiBold" Foreground="#E65100" />
        </WrapPanel>

        <!-- ============ HÀNG 3: LƯỚI CẤU HÌNH API ============ -->
        <GroupBox Grid.Row="2" Header="Danh sách API (nhập/sửa trực tiếp — gọi theo dữ liệu trên form, không cần lưu file)">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,4">
                <Button Content="Thêm API" Command="{Binding AddEndpointCommand}" Width="90" Background="#DCEDC8" />
                <Button Content="Xóa API đang chọn" Command="{Binding RemoveEndpointCommand}" Width="140" Margin="6,0,0,0" Background="#FFCDD2" />
                <TextBlock Text="Mẹo: chọn 1 dòng (click vào ô bất kỳ) rồi bấm 'Gọi API đang chọn'."
                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Endpoints}"
                      SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      GotFocus="ApiGrid_GotFocus"
                      HeadersVisibility="Column" GridLinesVisibility="All" Margin="2">
                <!-- Khi click/nhập vào ô (TextBox/CheckBox trong cell template), GotFocus sẽ chọn dòng đó
                     và GIỮ nguyên khi rời lưới (khác trigger IsKeyboardFocusWithin sẽ bỏ chọn khi mất focus). -->
                <DataGrid.Columns>
                    <!-- Dùng TemplateColumn + UpdateSourceTrigger=PropertyChanged để tick 1 lần là cập nhật ngay
                         (DataGridCheckBoxColumn mặc định phải click 2 lần mới commit → gây gọi sai API). -->
                    <DataGridTemplateColumn Header="Bật" Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tên" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Url" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Cần khoảng ngày" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding RequiresDateRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="DataType" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding LastStatus}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="ms" Binding="{Binding LastDurationMs}" Width="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="Bản ghi" Binding="{Binding LastRecordCount}" Width="65" IsReadOnly="True" />
                    <DataGridTextColumn Header="Lúc" Binding="{Binding LastCalledAt}" Width="70" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </GroupBox>

        <!-- ============ HÀNG 4: PHẢN HỒI ============ -->
        <GroupBox Grid.Row="3" Header="Dữ liệu trả về" Margin="0,8,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="URL: " Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding RequestUrlText, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                             TextWrapping="NoWrap" />
                    <Button Grid.Column="2" Content="Xóa phản hồi" Command="{Binding ClearResponseCommand}" Width="100" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" FontWeight="SemiBold"
                           Margin="2,0,2,6" Foreground="#0D47A1" />
                <TextBox Text="{Binding ResponseText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" AcceptsReturn="True" Margin="2" />
            </DockPanel>
        </GroupBox>

        <!-- ============ HÀNG 5: NHẬT KÝ ============ -->
        <GroupBox Grid.Row="4" Header="Nhật ký (mới nhất ở trên)" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Xóa nhật ký" Command="{Binding ClearLogCommand}"
                        HorizontalAlignment="Right" Width="100" Margin="2" />
                <ListBox ItemsSource="{Binding Logs}" ItemTemplate="{StaticResource LogRow}"
                         FontFamily="Consolas" FontSize="12"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="2" />
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
