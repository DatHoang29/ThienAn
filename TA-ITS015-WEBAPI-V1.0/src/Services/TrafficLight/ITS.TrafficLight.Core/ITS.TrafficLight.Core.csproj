<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ITS.TrafficLight.Core</RootNamespace>
    <AssemblyName>ITS.TrafficLight.Core</AssemblyName>
  </PropertyGroup>

  <!--
    ITS.TrafficLight.Core: Tầng lõi dịch vụ trung gian điều khiển Đèn tín hiệu giao thông (kênh ta.its.control.trafficlight).
