<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ITS.TrafficLight.Worker</RootNamespace>
    <AssemblyName>ITS.TrafficLight.Worker</AssemblyName>
  </PropertyGroup>

  <!--
    ITS.TrafficLight.Worker: Host chạy nền cho dịch vụ điều khiển Đèn tín hiệu giao thông (kênh ta.its.control.trafficlight).
    - Hỗ trợ chạy console hoặc Windows Service.
    - Endpoint /health kiểm tra trạng thái sống.
    Author: ChuongLP
    Date: 05/10/2026
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITS.TrafficLight.Core\ITS.TrafficLight.Core.csproj" />
    <ProjectReference Include="..\..\..\Modules\Integration\TrafficLight\Modules.Integration.TrafficLight.Siemens\Modules.Integration.TrafficLight.Siemens.csproj" />
    <ProjectReference Include="..\..\..\Modules\Integration\TrafficLight\Modules.Integration.TrafficLight.Modbus\Modules.Integration.TrafficLight.Modbus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Configuration\nats.creds">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
