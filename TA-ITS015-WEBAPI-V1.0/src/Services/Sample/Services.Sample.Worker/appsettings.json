{
  "Service": {
    "Name": "Sample",
    "DataConnectionId": "Default",
    "ConfigReloadSeconds": 60,
    "Queue": {
      "Capacity": 1000
    },
    "Devices": {
      "PluginDirectory": "plugins",
      "Enabled": true,
      "IntervalSeconds": 3,
      "DeviceAId": "DEVICE-A-01",
      "DeviceBId": "DEVICE-B-01"
    },
    "Api": {
      "Enabled": false,
      "Url": "https://localhost:5001/api/data",
      "IntervalSeconds": 10,
      "TimeoutSeconds": 30
    },
    "NatsInputSubject": "sample.input",
    "NatsOutputSubject": "sample.output"
  }
}
