<Window x:Class="Services.Sample.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sample Service Operator"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ActivityRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success">
                    <Setter Property="Foreground" Value="#1B7F3B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="#B8860B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="#C0392B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="Sample Service Operator" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,16"
                   TextWrapping="Wrap"
                   Text="Luồng demo: Khởi tạo → Start → thu thập Device A + Device B → tổng hợp → lưu/log/NATS. Các bước được phát về đây qua MediatR ActivityNotification." />

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding InitCommand}"
                    Content="Khởi tạo" />
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding StartCommand}"
                    Content="Start"
                    IsDefault="True" />
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding StopCommand}"
                    Content="Stop" />
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding SimulateCommand}"
                    Content="Simulate"
                    ToolTip="Sinh 1 batch dữ liệu giả lập để test pipeline khi không có device/NATS thật." />
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding ClearActivitiesCommand}"
                    Content="Xóa log" />
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,14,0,10"
                Padding="12,8"
                Background="#F2F4F7"
                CornerRadius="4">
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding StatusMessage}" />
        </Border>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Activities}"
                  RowStyle="{StaticResource ActivityRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontFamily="Consolas"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian"
                                    Width="110"
                                    Binding="{Binding TimestampLocal, StringFormat=HH:mm:ss.fff}" />
                <DataGridTextColumn Header="Bước"
                                    Width="90"
                                    Binding="{Binding Stage}" />
                <DataGridTextColumn Header="Chi tiết"
                                    Width="*"
                                    Binding="{Binding Detail}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
