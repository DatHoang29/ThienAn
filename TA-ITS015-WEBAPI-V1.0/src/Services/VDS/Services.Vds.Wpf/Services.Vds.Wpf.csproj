<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Services.Vds.Wpf</RootNamespace>
    <AssemblyName>Services.Vds.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- [ObservableProperty]/[RelayCommand] cho MainViewModel — bỏ boilerplate INPC + ICommand.
         Cùng phiên bản với Services.Sample.Wpf. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Services.Vds\Services.Vds.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Simulation\SampleImages\*.jpeg"
                      LogicalName="Services.Vds.Wpf.SampleImages.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\nats.creds">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\eventType.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Hạ tầng tách file theo khuôn service: DbConnection / Nats / Logging -->
    <None Update="Configuration\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\..\TAC_WebAPI\Configuration\nats.creds" Link="Configuration\nats.creds" />
    <None Include="..\Config\vdsconfig.json" Link="Config\vdsconfig.json" Condition="Exists('..\Config\vdsconfig.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- File creds NATS: KHÔNG nhân bản vào source, chỉ copy từ bản có sẵn của TAC_WebAPI lúc build.
         Cần khi Configuration/DataTransporter.json của harness khai AuthMode = JWT. -->
    <None Include="..\..\..\TAC_WebAPI\Configuration\camera.creds" Link="Configuration\camera.creds" Condition="Exists('..\..\..\TAC_WebAPI\Configuration\camera.creds')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
