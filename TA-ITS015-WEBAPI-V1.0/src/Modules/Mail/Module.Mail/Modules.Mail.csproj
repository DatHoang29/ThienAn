<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dùng MailKit thay System.Net.Mail.SmtpClient vì SmtpClient đã obsolete
         và không hỗ trợ SSL ngay từ đầu (port 465). -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Shared.DTO\Shared.DTO.csproj" />
    <ProjectReference Include="..\..\..\Shared\Shared.Reference\Shared.Reference.csproj" />
    <ProjectReference Include="..\..\..\Shared\Shared.Utility\Shared.Utility.csproj" />
    <ProjectReference Include="..\Module.Mail.Core\Modules.Mail.Core.csproj" />

    <!-- Đọc cấu hình (SysOpConfig) và danh mục mẫu email (SysConfigData) qua MessBus.
         Chỉ cần tầng Core (DTO), KHÔNG tham chiếu Modules.CfgSystem để tránh vòng lặp. -->
    <ProjectReference Include="..\..\CfgSystem\Modules.CfgSystem.Core\Modules.CfgSystem.Core.csproj" />

    <!-- Mã báo cáo + DTO tham số kết xuất báo cáo (dùng ở Infrastructure/Reports/TollReports). Chỉ tầng Core,
         việc render vẫn do Module.TOLL.Report làm và Mail gọi sang qua MessBus — không tham chiếu sang Report.
         Thêm phân hệ khác (WP, FMS...) thì tham chiếu {Phân hệ}.Core tương tự. -->
    <ProjectReference Include="..\..\TOLL\Module.TOLL.Core\Module.TOLL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BaseReportInput là lớp cha của mọi DTO tham số báo cáo, nằm trong DLL này.
         Không tham chiếu thì các DTO của Module.TOLL.Core không giải được kiểu cha. -->
    <Reference Include="Modules.Report.Base">
      <HintPath>..\..\..\DLLs\Modules.Report.Base.dll</HintPath>
    </Reference>
    <Reference Include="Modules.System">
      <HintPath>..\..\..\DLLs\Modules.System.dll</HintPath>
    </Reference>
    <Reference Include="Shared.Core">
      <HintPath>..\..\..\DLLs\Shared.Core.dll</HintPath>
    </Reference>
    <Reference Include="Shared.Infrastructure">
      <HintPath>..\..\..\DLLs\Shared.Infrastructure.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
