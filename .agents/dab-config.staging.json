{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.10/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DAB_STAGING_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": false
    },
    "graphql": {
      "enabled": false
    },
    "mcp": {
      "enabled": true
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    }
  },
  "entities": {
    "sys_databases": {
      "description": "SQL Server database catalog (read-only)",
      "source": {
        "type": "view",
        "object": "sys.databases",
        "key-fields": [
          "database_id"
        ]
      },
      "rest": false,
      "graphql": false,
      "mcp": {
        "dml-tools": true,
        "custom-tool": false
      },
      "health": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "sys_change_tracking_databases": {
      "description": "SQL Server Change Tracking database settings (read-only)",
      "source": {
        "type": "view",
        "object": "sys.change_tracking_databases",
        "key-fields": [
          "database_id"
        ]
      },
      "rest": false,
      "graphql": false,
      "mcp": {
        "dml-tools": true,
        "custom-tool": false
      },
      "health": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "sys_tables": {
      "description": "SQL Server table catalog (read-only)",
      "source": {
        "type": "view",
        "object": "sys.tables",
        "key-fields": [
          "object_id"
        ]
      },
      "rest": false,
      "graphql": false,
      "mcp": {
        "dml-tools": true,
        "custom-tool": false
      },
      "health": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "sys_indexes": {
      "description": "SQL Server index catalog for primary-key checks (read-only)",
      "source": {
        "type": "view",
        "object": "sys.indexes",
        "key-fields": [
          "object_id",
          "index_id"
        ]
      },
      "rest": false,
      "graphql": false,
      "mcp": {
        "dml-tools": true,
        "custom-tool": false
      },
      "health": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "sys_change_tracking_tables": {
      "description": "SQL Server Change Tracking table settings (read-only)",
      "source": {
        "type": "view",
        "object": "sys.change_tracking_tables",
        "key-fields": [
          "object_id"
        ]
      },
      "rest": false,
      "graphql": false,
      "mcp": {
        "dml-tools": true,
        "custom-tool": false
      },
      "health": {
        "enabled": false
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  },
  "autoentities": {
    "dbo-readonly": {
      "patterns": {
        "include": [
          "dbo.%"
        ],
        "name": "{object}"
      },
      "template": {
        "rest": {
          "enabled": false
        },
        "graphql": {
          "enabled": false
        },
        "mcp": {
          "dml-tools": true
        }
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "hangfire-readonly": {
      "patterns": {
        "include": [
          "HangFire.%"
        ],
        "name": "{schema}_{object}"
      },
      "template": {
        "rest": {
          "enabled": false
        },
        "graphql": {
          "enabled": false
        },
        "mcp": {
          "dml-tools": true
        }
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}
