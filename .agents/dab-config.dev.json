{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.10/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DAB_DEV_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": false
    },
    "graphql": {
      "enabled": false
    },
    "mcp": {
      "enabled": true
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "development"
    }
  },
  "autoentities": {
    "dbo-readonly": {
      "patterns": {
        "include": [
          "dbo.%"
        ],
        "name": "{object}"
      },
      "template": {
        "rest": {
          "enabled": false
        },
        "graphql": {
          "enabled": false
        },
        "mcp": {
          "dml-tools": true
        }
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "sys-readonly": {
      "patterns": {
        "include": [
          "sys.%"
        ],
        "name": "{schema}_{object}"
      },
      "template": {
        "rest": {
          "enabled": false
        },
        "graphql": {
          "enabled": false
        },
        "mcp": {
          "dml-tools": true
        }
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "hangfire-readonly": {
      "patterns": {
        "include": [
          "HangFire.%"
        ],
        "name": "{schema}_{object}"
      },
      "template": {
        "rest": {
          "enabled": false
        },
        "graphql": {
          "enabled": false
        },
        "mcp": {
          "dml-tools": true
        }
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}
