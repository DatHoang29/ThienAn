# Sao chép thành .agents/mcp/.env rồi điền mật khẩu. Tệp .env KHÔNG commit (đã bị .gitignore chặn).
# Launcher .agents/mcp/dab.mjs đọc tệp này; biến môi trường cùng tên được ưu tiên hơn.
# DB local chạy Docker container tac_webapi_sqlserver (cổng 14333 và 1433 cùng trỏ vào container này).
DAB_DEV_CONNECTION_STRING=Server=127.0.0.1,14333;Database=DEV_ITS10;User Id=sa;Password=<mật-khẩu>;TrustServerCertificate=True;ApplicationIntent=ReadOnly
DAB_TEST_CONNECTION_STRING=Server=127.0.0.1,14333;Database=test;User Id=sa;Password=<mật-khẩu>;TrustServerCertificate=True;ApplicationIntent=ReadOnly
# CSDL nhận chiều Inbound (ShareDataInboundPacket, bảng đích nhận) trên cùng container local
DAB_INBOUND_CONNECTION_STRING=Server=127.0.0.1,14333;Database=DEV_ITS015_Inbound;User Id=sa;Password=<mật-khẩu>;TrustServerCertificate=True;ApplicationIntent=ReadOnly
DAB_STAGING_CONNECTION_STRING=Server=10.10.12.80,1433;Database=DEV_ITS015;User Id=<user>;Password=<mật-khẩu>;TrustServerCertificate=True;ApplicationIntent=ReadOnly
