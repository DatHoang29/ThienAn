{
  "$schema": "hooks/hooks.schema.json",
  "enabled": true,
  "PreToolUse": [
    {
      "matcher": "run_command",
      "command": "node .agents/hooks/validate-tool-call.mjs",
      "timeout": 10
    },
    {
      "matcher": "run_command|write_file|edit_file|write_to_file|Write|Edit|Bash",
      "command": "node .agents/hooks/thienan-guardrails.mjs",
      "timeout": 10
    }
  ]
}
