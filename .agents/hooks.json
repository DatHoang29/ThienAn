{
  "thienan": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/session-context.mjs\" antigravity",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/gortex-hook.mjs\" antigravity",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(run_command|write_to_file|replace_file_content|multi_replace_file_content|edit_file|read_file|view_file|view_file_outline|view_code_item|grep_search|find_by_name|codebase_search)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/guarded-rtk.mjs\" antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
