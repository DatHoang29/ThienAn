{
  "mcpServers": {
    "gortex": {
      "command": "gortex",
      "args": [
        "mcp"
      ],
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "mssql_dev": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "dev"
      ]
    },
    "mssql_test": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "test"
      ]
    },
    "mssql_staging": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "staging"
      ]
    }
  }
}
