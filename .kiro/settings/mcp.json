{
  "mcpServers": {
    "gortex": {
      "command": "gortex",
      "args": [
        "mcp",
        "--tools",
        "facade-v1"
      ],
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      },
      "autoApprove": [
        "analyze",
        "capabilities",
        "change",
        "explore",
        "read",
        "recall",
        "relations",
        "response",
        "search",
        "trace",
        "workspace"
      ],
      "disabled": false
    },
    "mssql_dev": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "dev"
      ]
    },
    "mssql_test": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "test"
      ]
    },
    "mssql_staging": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "staging"
      ],
      "disabled": true
    }
  }
}
