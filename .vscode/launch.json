{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎨 WebVue (Dev Server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/TA-ITS015-WEBVUE-V1.0/src",
      "program": "${workspaceFolder}/TA-ITS015-WEBVUE-V1.0/src/node_modules/vite/bin/vite.js",
      "args": [],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bLocal:\\s+(http://localhost:\\d+/?)",
        "uriFormat": "%s"
      },
      "console": "internalConsole"
    },
    {
      "name": "🌐 TAC_WebAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-webapi-v1",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/TAC_WebAPI/bin/Debug/net10.0/TAC_WebAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/TAC_WebAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://(?:\\S+:)?(\\d+)",
        "uriFormat": "http://localhost:%s/api"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "📦 ShareDataWorker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-sharedata-worker",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/ShareData/ShareDataWorker/bin/Debug/net10.0/ShareDataWorker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/ShareData/ShareDataWorker",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "⚙️ ITS.VideoWall",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-videowall-worker",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall/bin/Debug/net10.0/ITS.VideoWall.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "⚙️ ITS.VideoWall (MockServer 18080)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-videowall-worker",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall/bin/Debug/net10.0/ITS.VideoWall.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "VideoWall__Device__IsLocal": "true"
      }
    },
    {
      "name": "🖥️ ITS.VideoWall.WPF",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-videowall-wpf",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall.WPF/bin/Debug/net10.0-windows/Module.VideoWall.WPF.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall.WPF",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "🧪 VideoWall Mock Server (Fake Device)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mockserver-runner",
      "program": "${workspaceFolder}/tests/BE/ITS/VideoWall/VwMockServerRunner/bin/Debug/net10.0/VwMockServerRunner.dll",
      "args": [],
      "cwd": "${workspaceFolder}/tests/BE/ITS/VideoWall/VwMockServerRunner",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "🧷 Attach to Process (.NET Core)",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      "name": "🚀 ShareData (WebAPI + Worker)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "📦 ShareDataWorker"
      ]
    },
    {
      "name": "🚀 Fullstack (WebAPI + WebVue)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "🎨 WebVue (Dev Server)"
      ]
    },
    {
      "name": "🖥️ VideoWall Suite",
      "configurations": [
        "🌐 TAC_WebAPI",
        "⚙️ ITS.VideoWall",
        "🖥️ ITS.VideoWall.WPF"
      ]
    },
    {
      "name": "🖥️ VideoWall Suite (+ MockServer)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "⚙️ ITS.VideoWall (MockServer 18080)",
        "🧪 VideoWall Mock Server (Fake Device)",
        "🖥️ ITS.VideoWall.WPF"
      ]
    }
  ]
}
