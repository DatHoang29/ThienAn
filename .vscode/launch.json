{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch TAC_WebAPI (Local Docker)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-webapi-v1",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/TAC_WebAPI/bin/Debug/net10.0/TAC_WebAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/TAC_WebAPI",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/api"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DbConnection__ConnectionConfigs__0__ConnectionString": "Server=localhost,14333;Database=DEV_ITS10;MultipleActiveResultSets=true;User ID=sa;Password=Password123!;TrustServerCertificate=True",
        "DbConnection__ConnectionConfigs__1__ConnectionString": "Server=localhost,14333;Database=DEV_ITS10_Log;MultipleActiveResultSets=true;User ID=sa;Password=Password123!;TrustServerCertificate=True"
      }
    },
