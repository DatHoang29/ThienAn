{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (TA-ShareData-WorkerService)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-worker",
      "program": "${workspaceFolder}/TA-ShareData-WorkerService/bin/Debug/net8.0/TA-ShareData-WorkerService.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ShareData-WorkerService",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET Core Launch (TA-ITS015-WebAPI-ShareData)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-its015",
      "program": "${workspaceFolder}/TA-ITS015-WebAPI-ShareData-V1.0/src/TAC_WebAPI/bin/Debug/net8.0/TAC_WebAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WebAPI-ShareData-V1.0/src/TAC_WebAPI",
      "stopAtEntry": false,
      "internalConsoleOptions": "openOnSessionStart",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://(?:\\[::\\]|[^:]+):(\\d+)",
        "uriFormat": "http://localhost:%s/api"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5005",
        "DOTNET_CLI_HOME": "${workspaceFolder}/.dotnet-home"
      }
    },
  ]
}