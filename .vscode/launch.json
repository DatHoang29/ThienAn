{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎨 WebVue (Dev Server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/TA-ITS015-WEBVUE-V1.0/src",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bLocal:\\s+(http://localhost:\\d+/?)",
        "uriFormat": "%s"
      },
      "presentation": { "group": "2-app", "order": 1 }
    },
    {
      "name": "🌐 TAC_WebAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-webapi-v1",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/TAC_WebAPI/bin/Debug/net10.0/TAC_WebAPI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/TAC_WebAPI",
      "stopAtEntry": false,
      "launchSettingsProfile": "TAC_WebAPI",
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+https?://(?:\\S+:)?(\\d+)",
        "uriFormat": "http://localhost:%s/api"
      },
      "presentation": { "group": "2-app", "order": 2 }
    },
    {
      "name": "📦 ShareDataWorker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-sharedata-worker",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/ShareData/ShareDataWorker/bin/Debug/net10.0/ShareDataWorker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/ShareData/ShareDataWorker",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "presentation": { "group": "2-app", "order": 3 }
    },
    {
      "name": "⚙️ ITS.VideoWall",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-videowall-worker",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall/bin/Debug/net10.0/ITS.VideoWall.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "presentation": { "group": "3-videowall", "order": 1 }
    },
    {
      "name": "⚙️ ITS.VideoWall (MockServer 18080)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-videowall-worker",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall/bin/Debug/net10.0/ITS.VideoWall.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "VideoWall__Device__IsLocal": "true"
      },
      "presentation": { "group": "3-videowall", "order": 2 }
    },
    {
      "name": "🖥️ ITS.VideoWall.WPF (Windows)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-videowall-wpf",
      "program": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall.WPF/bin/Debug/net10.0-windows/Module.VideoWall.WPF.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TA-ITS015-WEBAPI-V1.0/src/Services/VideoWall/ITS.VideoWall.WPF",
      "stopAtEntry": false,
      "console": "internalConsole",
      "presentation": { "group": "3-videowall", "order": 3 }
    },
    {
      "name": "🧪 VideoWall Mock Server (Fake Device)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mockserver-runner",
      "program": "${workspaceFolder}/tests/BE/ITS/VideoWall/VwMockServerRunner/bin/Debug/net10.0/VwMockServerRunner.dll",
      "args": [],
      "cwd": "${workspaceFolder}/tests/BE/ITS/VideoWall/VwMockServerRunner",
      "stopAtEntry": false,
      "console": "internalConsole",
      "presentation": { "group": "3-videowall", "order": 4 }
    },
    {
      "name": "🧷 Attach to Process (.NET Core)",
      "type": "coreclr",
      "request": "attach",
      "presentation": { "group": "4-other", "order": 1 }
    }
  ],
  "compounds": [
    {
      "name": "🚀 Fullstack (WebAPI + WebVue)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "🎨 WebVue (Dev Server)"
      ],
      "stopAll": true,
      "presentation": { "group": "1-suite", "order": 1 }
    },
    {
      "name": "🚀 ShareData (WebAPI + Worker)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "📦 ShareDataWorker"
      ],
      "preLaunchTask": "build-suite-sharedata",
      "stopAll": true,
      "presentation": { "group": "1-suite", "order": 2 }
    },
    {
      "name": "🖥️ VideoWall (WebAPI + Worker + MockServer)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "⚙️ ITS.VideoWall (MockServer 18080)",
        "🧪 VideoWall Mock Server (Fake Device)"
      ],
      "preLaunchTask": "build-suite-videowall-mock",
      "stopAll": true,
      "presentation": { "group": "1-suite", "order": 3 }
    },
    {
      "name": "🖥️ VideoWall Suite (Windows)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "⚙️ ITS.VideoWall",
        "🖥️ ITS.VideoWall.WPF (Windows)"
      ],
      "preLaunchTask": "build-suite-videowall",
      "stopAll": true,
      "presentation": { "group": "1-suite", "order": 4 }
    },
    {
      "name": "🖥️ VideoWall Suite + MockServer (Windows)",
      "configurations": [
        "🌐 TAC_WebAPI",
        "⚙️ ITS.VideoWall (MockServer 18080)",
        "🧪 VideoWall Mock Server (Fake Device)",
        "🖥️ ITS.VideoWall.WPF (Windows)"
      ],
      "preLaunchTask": "build-suite-videowall-mock-wpf",
      "stopAll": true,
      "presentation": { "group": "1-suite", "order": 5 }
    }
  ]
}
