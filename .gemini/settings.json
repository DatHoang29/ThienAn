{
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "gortex hook --agent gemini",
            "description": "Gortex graph context + stale-index hint",
            "name": "gortex",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "run_shell_command|search_file_content|glob"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "node $GEMINI_PROJECT_DIR/.agents/hooks/guardrails.mjs",
            "description": "Chặn vi phạm P0 của dự án",
            "name": "thienan-guardrails",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "^(run_shell_command|write_file|replace)$"
      },
      {
        "hooks": [
          {
            "command": "node $GEMINI_PROJECT_DIR/.agents/hooks/validate-tool-call.mjs",
            "description": "Chặn lệnh phá ổ đĩa",
            "name": "thienan-validate-tool-call",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "^run_shell_command$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gortex hook --agent gemini",
            "description": "Gortex session orientation",
            "name": "gortex",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcp": {
    "excluded": [
      "mssql_staging"
    ]
  },
  "mcpServers": {
    "gortex": {
      "command": "gortex",
      "args": [
        "mcp",
        "--tools",
        "facade-v1"
      ],
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "mssql_dev": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "dev"
      ]
    },
    "mssql_test": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "test"
      ]
    },
    "mssql_staging": {
      "command": "node",
      "args": [
        ".agents/mcp/dab.mjs",
        "staging"
      ]
    }
  }
}
