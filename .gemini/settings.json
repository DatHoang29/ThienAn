{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "gortex hook --agent gemini",
            "description": "Gortex graph context + stale-index hint",
            "name": "gortex",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "run_shell_command|search_file_content|glob"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gortex hook --agent gemini",
            "description": "Gortex session orientation",
            "name": "gortex",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "gortex": {
      "args": [
        "mcp"
      ],
      "command": "gortex",
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "mssql_dev": {
      "args": [
        "tool",
        "run",
        "--allow-roll-forward",
        "dab",
        "start",
        "--mcp-stdio",
        "role:anonymous",
        "--LogLevel",
        "Error",
        "--config",
        ".agents/dab-config.dev.json"
      ],
      "command": "dotnet",
      "env": {
        "ASPNETCORE_URLS": "http://127.0.0.1:0"
      }
    },
    "mssql_staging": {
      "args": [
        "tool",
        "run",
        "--allow-roll-forward",
        "dab",
        "start",
        "--mcp-stdio",
        "role:anonymous",
        "--LogLevel",
        "Error",
        "--config",
        ".agents/dab-config.staging.json"
      ],
      "command": "dotnet",
      "env": {
        "ASPNETCORE_URLS": "http://127.0.0.1:0"
      }
    },
    "mssql_test": {
      "args": [
        "tool",
        "run",
        "--allow-roll-forward",
        "dab",
        "start",
        "--mcp-stdio",
        "role:anonymous",
        "--LogLevel",
        "Error",
        "--config",
        ".agents/dab-config.test.json"
      ],
      "command": "dotnet",
      "env": {
        "ASPNETCORE_URLS": "http://127.0.0.1:0"
      }
    }
  }
}