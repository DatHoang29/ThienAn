				<incidentButtonsComp :zoneId="state.zoneInfo?.id" :kmNumber="state.midKmNumber" :metNumber="state.midMetNumber" :influenceScope="state.zoneInfo?.laneId?.toString()" @onSubmitSuccess="handleQuery" />
			</div>
