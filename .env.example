# Copy file này thành ".env" (cùng thư mục .agents/) rồi điền giá trị thật.
# .env đã được thêm vào .gitignore — KHÔNG BAO GIỜ commit file .env thật chứa mật khẩu.
# Mật khẩu ứng với mỗi biến: chạy script SQL tương ứng trong .agents/sql/ trước
# (create-mcp-reader-dev.sql / -test.sql / -staging.sql) để tạo login mcp_reader,
# rồi copy đúng mật khẩu đã đặt trong script đó vào đây.

DAB_DEV_CONNECTION_STRING=Server=localhost,14333;Database=dev_its10;User ID=mcp_reader;Password=CHANGE_ME;TrustServerCertificate=True;ApplicationIntent=ReadOnly;
DAB_TEST_CONNECTION_STRING=Server=localhost,14333;Database=test;User ID=mcp_reader;Password=CHANGE_ME;TrustServerCertificate=True;ApplicationIntent=ReadOnly;
DAB_STAGING_CONNECTION_STRING=Server=10.10.8.30;Database=dev_its10;User ID=mcp_reader;Password=CHANGE_ME;TrustServerCertificate=True;ApplicationIntent=ReadOnly;
